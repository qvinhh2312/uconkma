<?xml version="1.0" encoding="ASCII" standalone="no"?>
<ucon:PolicyModel xmlns:ucon="http://www.kma.edu.vn/ucon" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmi:version="2.0">
    
  <policies denyReason="TUITION_NOT_PAID" description="Chi cho phep SV da hoan tat hoc phi" effect="PERMIT" objectType="ClassSection" phase="PRE" policyId="P01_TuitionPaid_PreA0" policyStatus="ACTIVE" predicate="AUTHORIZATION" priority="100" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="REGISTER" uconVariant="preA0" updateTiming="NONE" version="1.0">
        
    <condition operator="EQUALS" xsi:type="ucon:RelationalOperator">
            
      <left entity="SUBJECT" path="tuitionPaid" xsi:type="ucon:VariableAccess"/>
            
      <right type="BOOLEAN" value="true" xsi:type="ucon:Constant"/>
          
    </condition>
      
  </policies>
    
  <policies denyReason="SYSTEM_UNDER_MAINTENANCE" description="Chi cho giao dich khi he thong khong o trang thai bao tri" effect="PERMIT" objectType="ClassSection" phase="PRE" policyId="P13a_EmergencyMaintenance_PreC0" policyStatus="ACTIVE" predicate="CONDITION" priority="95" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="ANY" uconVariant="preC0" updateTiming="NONE" version="1.0">
        
    <condition operator="EQUALS" xsi:type="ucon:RelationalOperator">
            
      <left entity="ENVIRONMENT" path="isMaintenance" xsi:type="ucon:VariableAccess"/>
            
      <right type="BOOLEAN" value="false" xsi:type="ucon:Constant"/>
          
    </condition>
      
  </policies>
    
  <policies denyReason="OUTSIDE_TRANSACTION_WINDOW" description="Chi cho giao dich trong dot va gio hop le" effect="PERMIT" objectType="ClassSection" phase="PRE" policyId="P02_TransactionWindow_PreC0" policyStatus="ACTIVE" predicate="CONDITION" priority="90" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="ANY" uconVariant="preC0" updateTiming="NONE" version="1.0">
        
    <condition operator="AND" xsi:type="ucon:LogicalOperator">
            
      <left operator="AND" xsi:type="ucon:LogicalOperator">
                
        <left operator="IN" xsi:type="ucon:RelationalOperator">
                    
          <left entity="ENVIRONMENT" path="registrationPhase" xsi:type="ucon:VariableAccess"/>
                    
          <right elementType="ENUM" xsi:type="ucon:ListConstant">
                        
            <values>NORMAL</values>
                        
            <values>LATE</values>
                      
          </right>
                  
        </left>
                
        <right operator="GREATER_OR_EQUALS" xsi:type="ucon:RelationalOperator">
                    
          <left entity="ENVIRONMENT" path="currentDateTime" xsi:type="ucon:VariableAccess"/>
                    
          <right entity="ENVIRONMENT" path="openTime" xsi:type="ucon:VariableAccess"/>
                  
        </right>
              
      </left>
            
      <right operator="LESS_OR_EQUALS" xsi:type="ucon:RelationalOperator">
                
        <left entity="ENVIRONMENT" path="currentDateTime" xsi:type="ucon:VariableAccess"/>
                
        <right entity="ENVIRONMENT" path="closeTime" xsi:type="ucon:VariableAccess"/>
              
      </right>
          
    </condition>
      
  </policies>
    
  <policies denyReason="CLASS_NOT_OPEN" description="Chi lop dang mo thuc su moi duoc dang ky" effect="PERMIT" objectType="ClassSection" phase="PRE" policyId="P03_ClassStatusOpen_PreA0" policyStatus="ACTIVE" predicate="AUTHORIZATION" priority="80" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="REGISTER" uconVariant="preA0" updateTiming="NONE" version="1.0">
        
    <condition operator="EQUALS" xsi:type="ucon:RelationalOperator">
            
      <left entity="OBJECT" path="status" xsi:type="ucon:VariableAccess"/>
            
      <right type="STRING" value="OPEN" xsi:type="ucon:Constant"/>
          
    </condition>
      
  </policies>
    
  <policies denyReason="ALREADY_REGISTERED" description="Khong cho dang ky trung cung lop" effect="PERMIT" objectType="ClassSection" phase="PRE" policyId="P04_NotAlreadyRegistered_PreA0" policyStatus="ACTIVE" predicate="AUTHORIZATION" priority="70" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="REGISTER" uconVariant="preA0" updateTiming="NONE" version="1.0">
        
    <condition operator="NOT" xsi:type="ucon:LogicalOperator">
            
      <left functionName="checkExistsRegistration" xsi:type="ucon:FunctionCall">
                
        <arguments entity="SUBJECT" path="studentId" xsi:type="ucon:VariableAccess"/>
                
        <arguments entity="OBJECT" path="classId" xsi:type="ucon:VariableAccess"/>
                
        <arguments entity="ENVIRONMENT" path="semester" xsi:type="ucon:VariableAccess"/>
              
      </left>
          
    </condition>
      
  </policies>
    
  <policies denyReason="NOT_REGISTERED" description="Chi cho huy lop khi SV da co giao dich dang ky hop le" effect="PERMIT" objectType="ClassSection" phase="PRE" policyId="P16_DropOnlyIfRegistered_PreA0" policyStatus="ACTIVE" predicate="AUTHORIZATION" priority="65" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="DROP" uconVariant="preA0" updateTiming="NONE" version="1.0">
        
    <condition functionName="checkExistsRegistration" xsi:type="ucon:FunctionCall">
            
      <arguments entity="SUBJECT" path="studentId" xsi:type="ucon:VariableAccess"/>
            
      <arguments entity="OBJECT" path="classId" xsi:type="ucon:VariableAccess"/>
            
      <arguments entity="ENVIRONMENT" path="semester" xsi:type="ucon:VariableAccess"/>
          
    </condition>
      
  </policies>
    
  <policies denyReason="OUTSIDE_DROP_WINDOW" description="Chi cho huy hoc phan trong khung thoi gian cho phep" effect="PERMIT" objectType="ClassSection" phase="PRE" policyId="P21_DropWindow_PreC0" policyStatus="ACTIVE" predicate="CONDITION" priority="64" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="DROP" uconVariant="preC0" updateTiming="NONE" version="1.0">
        
    <condition operator="AND" xsi:type="ucon:LogicalOperator">
            
      <left operator="GREATER_OR_EQUALS" xsi:type="ucon:RelationalOperator">
                
        <left entity="ENVIRONMENT" path="currentDateTime" xsi:type="ucon:VariableAccess"/>
                
        <right entity="ENVIRONMENT" path="openTime" xsi:type="ucon:VariableAccess"/>
              
      </left>
            
      <right operator="LESS_OR_EQUALS" xsi:type="ucon:RelationalOperator">
                
        <left entity="ENVIRONMENT" path="currentDateTime" xsi:type="ucon:VariableAccess"/>
                
        <right entity="ENVIRONMENT" path="closeTime" xsi:type="ucon:VariableAccess"/>
              
      </right>
          
    </condition>
      
  </policies>
    
  <policies denyReason="MAX_DROP_TIMES_EXCEEDED" description="Gioi han so lan huy hoc phan trong hoc ky" effect="PERMIT" objectType="ClassSection" phase="PRE" policyId="P26_MaxDropTimes_PreA0" policyStatus="ACTIVE" predicate="AUTHORIZATION" priority="63" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="DROP" uconVariant="preA0" updateTiming="NONE" version="1.0">
        
    <condition operator="LESS_THAN" xsi:type="ucon:RelationalOperator">
            
      <left entity="SUBJECT" path="dropCountForSemester" xsi:type="ucon:VariableAccess"/>
            
      <right entity="ENVIRONMENT" path="maxDropTimes" xsi:type="ucon:VariableAccess"/>
          
    </condition>
      
  </policies>
    
  <policies denyReason="CREDIT_LIMIT_EXCEEDED" description="Khong vuot tran han muc tin chi thuc te" effect="PERMIT" objectType="ClassSection" phase="PRE" policyId="P05_CreditLimit_PreA0" policyStatus="ACTIVE" predicate="AUTHORIZATION" priority="60" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="REGISTER" uconVariant="preA0" updateTiming="NONE" version="1.0">
        
    <condition operator="LESS_OR_EQUALS" xsi:type="ucon:RelationalOperator">
            
      <left operator="ADD" xsi:type="ucon:ArithmeticOperator">
                
        <left entity="SUBJECT" path="currentCredits" xsi:type="ucon:VariableAccess"/>
                
        <right entity="OBJECT" path="course.credits" xsi:type="ucon:VariableAccess"/>
              
      </left>
            
      <right entity="SUBJECT" path="maxCreditsEffective" xsi:type="ucon:VariableAccess"/>
          
    </condition>
      
  </policies>
    
  <policies denyReason="MAX_REGISTER_ATTEMPTS_EXCEEDED" description="Gioi han so lan thu dang ky trong mot dot" effect="PERMIT" objectType="ClassSection" phase="PRE" policyId="P25_MaxRegisterAttempts_PreA0" policyStatus="ACTIVE" predicate="AUTHORIZATION" priority="55" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="REGISTER" uconVariant="preA0" updateTiming="NONE" version="1.0">
        
    <condition operator="LESS_THAN" xsi:type="ucon:RelationalOperator">
            
      <left entity="SUBJECT" path="registerAttemptCount" xsi:type="ucon:VariableAccess"/>
            
      <right entity="ENVIRONMENT" path="maxRegisterAttempts" xsi:type="ucon:VariableAccess"/>
          
    </condition>
      
  </policies>
    
  <policies denyReason="PREREQUISITE_NOT_MET" description="Dam bao da hoan tat mon hoc tien quyet" effect="PERMIT" objectType="ClassSection" phase="PRE" policyId="P06_Prerequisite_PreA0" policyStatus="ACTIVE" predicate="AUTHORIZATION" priority="50" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="REGISTER" uconVariant="preA0" updateTiming="NONE" version="1.0">
        
    <condition operator="SUBSET_OF" xsi:type="ucon:RelationalOperator">
            
      <left entity="OBJECT" path="course.prerequisites" xsi:type="ucon:VariableAccess"/>
            
      <right entity="SUBJECT" path="completedCourses" xsi:type="ucon:VariableAccess"/>
          
    </condition>
      
  </policies>
    
  <policies denyReason="REGULATION_NOT_CONFIRMED" description="Sinh vien phai xac nhan quy che dang ky truoc khi gui request" effect="PERMIT" objectType="ClassSection" phase="PRE" policyId="P17_AgreeRegistrationRule_PreB0" policyStatus="ACTIVE" predicate="OBLIGATION" priority="45" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="REGISTER" uconVariant="preB0" updateTiming="NONE" version="1.0">
        
    <condition operator="EQUALS" xsi:type="ucon:RelationalOperator">
            
      <left entity="REQUEST" path="confirmedRegistrationRule" xsi:type="ucon:VariableAccess"/>
            
      <right type="BOOLEAN" value="true" xsi:type="ucon:Constant"/>
          
    </condition>
      
  </policies>
    
  <policies denyReason="SCHEDULE_CONFLICT" description="Tranh trung lich hoc voi cac mon da chon" effect="PERMIT" objectType="ClassSection" phase="PRE" policyId="P07_ScheduleConflict_PreA0" policyStatus="ACTIVE" predicate="AUTHORIZATION" priority="40" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="REGISTER" uconVariant="preA0" updateTiming="NONE" version="1.0">
        
    <condition operator="NOT" xsi:type="ucon:LogicalOperator">
            
      <left operator="OVERLAPS" xsi:type="ucon:RelationalOperator">
                
        <left entity="OBJECT" path="scheduleSlots" xsi:type="ucon:VariableAccess"/>
                
        <right entity="SUBJECT" path="registeredScheduleSlots" xsi:type="ucon:VariableAccess"/>
              
      </left>
          
    </condition>
      
  </policies>
    
  <policies denyReason="OVERRIDE_REASON_REQUIRED" description="Neu dung override hoc vu thi phai co ly do" effect="PERMIT" objectType="ClassSection" phase="PRE" policyId="P18_AdminOverrideReason_PreB0" policyStatus="ACTIVE" predicate="OBLIGATION" priority="35" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="REGISTER" uconVariant="preB0" updateTiming="NONE" version="1.0">
        
    <condition operator="OR" xsi:type="ucon:LogicalOperator">
            
      <left operator="EQUALS" xsi:type="ucon:RelationalOperator">
                
        <left entity="REQUEST" path="adminOverride" xsi:type="ucon:VariableAccess"/>
                
        <right type="BOOLEAN" value="false" xsi:type="ucon:Constant"/>
              
      </left>
            
      <right operator="NOT_EQUALS" xsi:type="ucon:RelationalOperator">
                
        <left entity="REQUEST" path="overrideReason" xsi:type="ucon:VariableAccess"/>
                
        <right type="STRING" value="" xsi:type="ucon:Constant"/>
              
      </right>
          
    </condition>
      
  </policies>
    
  <policies description="Tang so lan thu dang ky cho moi request hop le o PRE" effect="PERMIT" objectType="ClassSection" phase="PRE" policyId="P19_RegisterAttempt_PreA1" policyStatus="ACTIVE" predicate="AUTHORIZATION" priority="5" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="REGISTER" uconVariant="preA1" updateTiming="PRE" version="1.0">
        
    <condition type="BOOLEAN" value="true" xsi:type="ucon:Constant"/>
        
    <preUpdates operator="ADD_ASSIGN" xsi:type="ucon:UpdateStatement">
            
      <target entity="SUBJECT" path="registerAttemptCount"/>
            
      <value type="INTEGER" value="1" xsi:type="ucon:Constant"/>
          
    </preUpdates>
      
  </policies>
    
  <policies denyReason="SYSTEM_UNDER_MAINTENANCE" description="Ngat giao dich dang lo lung neu Admin kich hoat bao tri khan cap" effect="PERMIT" objectType="ClassSection" phase="ONGOING" policyId="P13_EmergencyMaintenance_OnC0" policyStatus="ACTIVE" predicate="CONDITION" priority="50" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="ANY" uconVariant="onC0" updateTiming="NONE" version="1.0">
        
    <condition operator="EQUALS" xsi:type="ucon:RelationalOperator">
            
      <left entity="ENVIRONMENT" path="isMaintenance" xsi:type="ucon:VariableAccess"/>
            
      <right type="BOOLEAN" value="false" xsi:type="ucon:Constant"/>
          
    </condition>
      
  </policies>
    
  <policies denyReason="CLASS_FULL_ON_COMMIT" description="Chong race condition o slot cuoi cung" effect="PERMIT" objectType="ClassSection" phase="ONGOING" policyId="P08_CapacityRecheck_OnA0" policyStatus="ACTIVE" predicate="AUTHORIZATION" priority="30" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="REGISTER" uconVariant="onA0" updateTiming="NONE" version="1.0">
        
    <condition operator="LESS_THAN" xsi:type="ucon:RelationalOperator">
            
      <left entity="OBJECT" path="enrolled" xsi:type="ucon:VariableAccess"/>
            
      <right entity="OBJECT" path="capacity" xsi:type="ucon:VariableAccess"/>
          
    </condition>
      
  </policies>
    
  <policies denyReason="NO_SEAT_TO_RESERVE" description="Giu tam mot cho truoc khi commit dang ky" effect="PERMIT" objectType="ClassSection" phase="ONGOING" policyId="P20_ReserveSeat_OnA2" policyStatus="ACTIVE" predicate="AUTHORIZATION" priority="25" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="REGISTER" uconVariant="onA2" updateTiming="ONGOING" version="1.0">
        
    <condition operator="LESS_THAN" xsi:type="ucon:RelationalOperator">
            
      <left operator="ADD" xsi:type="ucon:ArithmeticOperator">
                
        <left entity="OBJECT" path="enrolled" xsi:type="ucon:VariableAccess"/>
                
        <right entity="OBJECT" path="reservedSeats" xsi:type="ucon:VariableAccess"/>
              
      </left>
            
      <right entity="OBJECT" path="capacity" xsi:type="ucon:VariableAccess"/>
          
    </condition>
        
    <ongoingUpdates operator="ADD_ASSIGN" xsi:type="ucon:UpdateStatement">
            
      <target entity="OBJECT" path="reservedSeats"/>
            
      <value type="INTEGER" value="1" xsi:type="ucon:Constant"/>
          
    </ongoingUpdates>
        
    <rollbackUpdates operator="SUB_ASSIGN" xsi:type="ucon:UpdateStatement">
            
      <target entity="OBJECT" path="reservedSeats"/>
            
      <value type="INTEGER" value="1" xsi:type="ucon:Constant"/>
          
    </rollbackUpdates>
      
  </policies>
    
  <policies denyReason="DROP_CLASS_STATUS_CHANGED" description="Khong cho huy neu lop bi khoa trong luc xu ly" effect="PERMIT" objectType="ClassSection" phase="ONGOING" policyId="P23_DropLockedClass_OnA0" policyStatus="ACTIVE" predicate="AUTHORIZATION" priority="22" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="DROP" uconVariant="onA0" updateTiming="NONE" version="1.0">
        
    <condition operator="EQUALS" xsi:type="ucon:RelationalOperator">
            
      <left entity="OBJECT" path="status" xsi:type="ucon:VariableAccess"/>
            
      <right type="STRING" value="OPEN" xsi:type="ucon:Constant"/>
          
    </condition>
      
  </policies>
    
  <policies denyReason="CLASS_STATUS_CHANGED" description="Kiem tra lai trang thai lop phong khi Admin khoa dot xuat" effect="PERMIT" objectType="ClassSection" phase="ONGOING" policyId="P09_ClassStatusRecheck_OnA0" policyStatus="ACTIVE" predicate="AUTHORIZATION" priority="20" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="REGISTER" uconVariant="onA0" updateTiming="NONE" version="1.0">
        
    <condition operator="EQUALS" xsi:type="ucon:RelationalOperator">
            
      <left entity="OBJECT" path="status" xsi:type="ucon:VariableAccess"/>
            
      <right type="STRING" value="OPEN" xsi:type="ucon:Constant"/>
          
    </condition>
      
  </policies>
    
  <policies denyReason="USAGE_SESSION_EXPIRED" description="Usage session phai con hop le trong suot qua trinh xu ly giao dich" effect="PERMIT" objectType="ClassSection" phase="ONGOING" policyId="P27_SessionLease_OnB0" policyStatus="ACTIVE" predicate="OBLIGATION" priority="18" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="ANY" uconVariant="onB0" updateTiming="NONE" version="1.0">
        
    <condition operator="EQUALS" xsi:type="ucon:RelationalOperator">
            
      <left entity="REQUEST" path="sessionLeaseValid" xsi:type="ucon:VariableAccess"/>
            
      <right type="BOOLEAN" value="true" xsi:type="ucon:Constant"/>
          
    </condition>
      
  </policies>
    
  <policies denyReason="STUDENT_ON_HOLD" description="Kiem tra tinh trang hold cua SV truoc commit dang ky" effect="PERMIT" objectType="ClassSection" phase="ONGOING" policyId="P10_StudentHoldRecheck_OnA0" policyStatus="ACTIVE" predicate="AUTHORIZATION" priority="10" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="REGISTER" uconVariant="onA0" updateTiming="NONE" version="1.0">
        
    <condition functionName="isEmpty" xsi:type="ucon:FunctionCall">
            
      <arguments entity="SUBJECT" path="holds" xsi:type="ucon:VariableAccess"/>
          
    </condition>
      
  </policies>
    
  <policies description="Commit dang ky: transaction, state subject object, tuition debt" effect="PERMIT" objectType="ClassSection" phase="POST" policyId="P11_RegisterStateUpdate_PostA3" policyStatus="ACTIVE" predicate="AUTHORIZATION" priority="8" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="REGISTER" uconVariant="postA3" updateTiming="POST" version="1.0">
        
    <condition type="BOOLEAN" value="true" xsi:type="ucon:Constant"/>
        
    <postUpdates entityName="Transaction" xsi:type="ucon:CreateTransactionStatement">
            
      <arguments entity="SUBJECT" path="studentId" xsi:type="ucon:VariableAccess"/>
            
      <arguments entity="OBJECT" path="classId" xsi:type="ucon:VariableAccess"/>
            
      <arguments entity="ENVIRONMENT" path="semester" xsi:type="ucon:VariableAccess"/>
            
      <arguments type="STRING" value="REGISTER" xsi:type="ucon:Constant"/>
          
    </postUpdates>
        
    <postUpdates operator="SUB_ASSIGN" xsi:type="ucon:UpdateStatement">
            
      <target entity="OBJECT" path="reservedSeats"/>
            
      <value type="INTEGER" value="1" xsi:type="ucon:Constant"/>
          
    </postUpdates>
        
    <postUpdates operator="ADD_ASSIGN" xsi:type="ucon:UpdateStatement">
            
      <target entity="OBJECT" path="enrolled"/>
            
      <value type="INTEGER" value="1" xsi:type="ucon:Constant"/>
          
    </postUpdates>
        
    <postUpdates operator="ADD_ASSIGN" xsi:type="ucon:UpdateStatement">
            
      <target entity="SUBJECT" path="currentCredits"/>
            
      <value entity="OBJECT" path="course.credits" xsi:type="ucon:VariableAccess"/>
          
    </postUpdates>
        
    <postUpdates operator="APPEND" xsi:type="ucon:UpdateStatement">
            
      <target entity="SUBJECT" path="registeredScheduleSlots"/>
            
      <value entity="OBJECT" path="scheduleSlots" xsi:type="ucon:VariableAccess"/>
          
    </postUpdates>
        
    <postUpdates operator="APPEND" xsi:type="ucon:UpdateStatement">
            
      <target entity="SUBJECT" path="registeredClassIds"/>
            
      <value entity="OBJECT" path="classId" xsi:type="ucon:VariableAccess"/>
          
    </postUpdates>
        
    <postUpdates operator="ADD_ASSIGN" xsi:type="ucon:UpdateStatement">
            
      <target entity="SUBJECT" path="tuitionDebt"/>
            
      <value entity="OBJECT" path="course.tuitionFee" xsi:type="ucon:VariableAccess"/>
          
    </postUpdates>
      
  </policies>
    
  <policies description="Commit huy lop: xoa transaction, hoan state va cap nhat settlement" effect="PERMIT" objectType="ClassSection" phase="POST" policyId="P14_DropStateRevert_PostA3" policyStatus="ACTIVE" predicate="AUTHORIZATION" priority="8" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="DROP" uconVariant="postA3" updateTiming="POST" version="1.0">
        
    <condition type="BOOLEAN" value="true" xsi:type="ucon:Constant"/>
        
    <postUpdates entityName="Transaction" xsi:type="ucon:DeleteTransactionStatement">
            
      <arguments entity="SUBJECT" path="studentId" xsi:type="ucon:VariableAccess"/>
            
      <arguments entity="OBJECT" path="classId" xsi:type="ucon:VariableAccess"/>
            
      <arguments entity="ENVIRONMENT" path="semester" xsi:type="ucon:VariableAccess"/>
          
    </postUpdates>
        
    <postUpdates operator="SUB_ASSIGN" xsi:type="ucon:UpdateStatement">
            
      <target entity="OBJECT" path="enrolled"/>
            
      <value type="INTEGER" value="1" xsi:type="ucon:Constant"/>
          
    </postUpdates>
        
    <postUpdates operator="SUB_ASSIGN" xsi:type="ucon:UpdateStatement">
            
      <target entity="SUBJECT" path="currentCredits"/>
            
      <value entity="OBJECT" path="course.credits" xsi:type="ucon:VariableAccess"/>
          
    </postUpdates>
        
    <postUpdates operator="REMOVE" xsi:type="ucon:UpdateStatement">
            
      <target entity="SUBJECT" path="registeredScheduleSlots"/>
            
      <value entity="OBJECT" path="scheduleSlots" xsi:type="ucon:VariableAccess"/>
          
    </postUpdates>
        
    <postUpdates operator="REMOVE" xsi:type="ucon:UpdateStatement">
            
      <target entity="SUBJECT" path="registeredClassIds"/>
            
      <value entity="OBJECT" path="classId" xsi:type="ucon:VariableAccess"/>
          
    </postUpdates>
        
    <postUpdates operator="ADD_ASSIGN" xsi:type="ucon:UpdateStatement">
            
      <target entity="SUBJECT" path="dropCountForSemester"/>
            
      <value type="INTEGER" value="1" xsi:type="ucon:Constant"/>
          
    </postUpdates>
        
    <postUpdates operator="SUB_ASSIGN" xsi:type="ucon:UpdateStatement">
            
      <target entity="SUBJECT" path="tuitionDebt"/>
            
      <value entity="OBJECT" path="course.tuitionFee" xsi:type="ucon:VariableAccess"/>
          
    </postUpdates>
      
  </policies>
    
  <policies description="Ghi audit log cho moi request" effect="PERMIT" objectType="ClassSection" phase="POST" policyId="P12_AuditAndTrace_PostB3" policyStatus="ACTIVE" predicate="OBLIGATION" priority="1" source="Quy che dang ky hoc phan KMA" subjectType="Student" targetAction="ANY" uconVariant="postB3" updateTiming="POST" version="1.0">
        
    <condition type="BOOLEAN" value="true" xsi:type="ucon:Constant"/>
        
    <postUpdates xsi:type="ucon:AuditLogStatement">
            
      <arguments entity="REQUEST" path="requestId" xsi:type="ucon:VariableAccess"/>
            
      <arguments entity="SUBJECT" path="studentId" xsi:type="ucon:VariableAccess"/>
            
      <arguments entity="OBJECT" path="classId" xsi:type="ucon:VariableAccess"/>
            
      <arguments entity="REQUEST" path="decision" xsi:type="ucon:VariableAccess"/>
            
      <arguments entity="REQUEST" path="failedPolicyCodes" xsi:type="ucon:VariableAccess"/>
          
    </postUpdates>
      
  </policies>
    
  <policySets combiningAlgorithm="DENY_OVERRIDES" policySetId="RegistrationPolicySet">
        
    <policyIds>P01_TuitionPaid_PreA0</policyIds>
        
    <policyIds>P13a_EmergencyMaintenance_PreC0</policyIds>
        
    <policyIds>P02_TransactionWindow_PreC0</policyIds>
        
